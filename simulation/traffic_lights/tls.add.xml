<additional>
    <!-- Define Phase patterns for J1 (center intersection) -->
    <!-- States link: North-South priority (GG), East-West priority (rr) -->
    <tlLogic id="center" type="static" programID="0" offset="0">
        <!-- Phase 0: North-South Green -->
        <phase duration="31" state="GGggrrrrGGgg"/>
        <!-- Phase 1: North-South Yellow -->
        <phase duration="4"  state="yyyyrrrryyyy"/>
        <!-- Phase 2: East-West Green -->
        <phase duration="31" state="rrrrGGggrrrr"/>
        <!-- Phase 3: East-West Yellow -->
        <phase duration="4"  state="rrrryyyyrrrr"/>
    </tlLogic>
</additional>
