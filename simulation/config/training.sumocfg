<configuration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/sumoConfiguration.xsd">
    <input>
        <net-file value="../network/city.net.xml"/>
        <route-files value="../routes/traffic.rou.xml,../routes/demand.rou.xml"/>
        <additional-files value="../routes/vehicles.add.xml,../traffic_lights/tls.add.xml"/>
    </input>
    <time>
        <begin value="0"/>
        <end value="1000"/>
        <step-length value="0.1"/>
    </time>
    <report>
        <verbose value="false"/>
        <no-step-log value="true"/>
    </report>
</configuration>
