# ==============================================================================
# EcoTwin Gitignore Configuration
# ==============================================================================

# Python Caches & Compiled Files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Python Virtual Environments
.venv
.venv/
venv/
ENV/
env/
pyvenv.cfg

# Jupyter Notebook Checkpoints
.ipynb_checkpoints/

# Testing & Linting Caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Machine Learning Artifacts & Checkpoints
*.pt
*.pth
*.ckpt
*.onnx
*.safetensors
*.joblib
*.pkl
*.zip
models/ppo/checkpoints/*
models/ppo/best_model/*
!models/ppo/checkpoints/.gitkeep
!models/ppo/best_model/.gitkeep

# Reinforcement Learning Output
ray_results/
results/
runs/
checkpoints/

# Datasets & Simulation Outputs (Ignore large data files)
data/raw/*.csv
data/raw/*.parquet
data/raw/*.feather
data/raw/*.joblib
data/processed/*.csv
data/processed/*.parquet
data/processed/*.feather
data/processed/*.joblib
data/simulation_runs/*
data/emissions/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/simulation_runs/.gitkeep
!data/emissions/.gitkeep
!data/metadata/.gitkeep

# SUMO Generated & Backup Files
*.sbx
*.net.xml.bak
*.rou.xml.bak
*.add.xml.bak
*.sumocfg.bak
*.poly.xml.bak
*.trips.xml.bak
*.xml.bak
simulation/output/
simulation/tapas_cologne/*.log

# Logs & Temporary Files
*.log
logs/
tmp/
temp/
*.tmp
*.temp

# Node & React Frontend
node_modules/
frontend/node_modules/
dist/
frontend/dist/
dist-ssr/
*.local
.eslintcache
.stylelintcache
*.tsbuildinfo
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment Config & Secrets
.env
.env.*
!.env.example
*.pem
*.key
*.secret

# IDE & Editors
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/tasks.json
!.vscode/launch.json
.idea/
*.iml
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo

# Operating System Files
.DS_Store
Thumbs.db
Desktop.ini

# Build / Distribution
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Large TAPAS Cologne simulation files (must not be committed directly to Git)
simulation/tapas_cologne/cologne.net.xml
simulation/tapas_cologne/cologne.poly.xml
simulation/tapas_cologne/cologne.trips.xml
cologne_landmark_distances.txt
simulation/tapas_cologne/cologne_landmark_distances.txt
