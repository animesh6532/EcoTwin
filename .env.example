# EcoTwin App Settings
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=info
FRONTEND_URL=http://localhost:3000

# SUMO Settings
# On Windows e.g., C:\Program Files (x86)\Eclipse\Sumo
SUMO_HOME=
# sumo or sumo-gui
SUMO_BINARY=sumo-gui
SIMULATION_STEP_LENGTH=0.1
SIMULATION_DURATION=3600
WEBSOCKET_INTERVAL=1.0

# Database Settings
# Fallback to sqlite if empty
DATABASE_URL=sqlite:///./ecotwin.db

# RL Settings
MODEL_VERSION=1.0.0
