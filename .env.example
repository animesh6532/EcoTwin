# EcoTwin - Environment Configuration Template
# Copy this file to '.env' and adjust the variables for your local system.

# Backend API configuration
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=info

# Frontend Client URL (for CORS)
FRONTEND_URL=http://localhost:5173

# SUMO (Simulation of Urban MObility) Home path
# On Windows, this is typically where Eclipse Sumo is installed.
# On Linux, this is typically /usr/share/sumo
SUMO_HOME=C:\Program Files (x86)\Eclipse\Sumo
SUMO_GUI=false

# SQLite Database connection URL
DATABASE_URL=sqlite:///./ecotwin.db

# Reinforcement Learning training defaults
TRAINING_TIMESTEPS=100000
LEARNING_RATE=0.0003
BATCH_SIZE=64
N_STEPS=2048
GAMMA=0.99
MODEL_VERSION=1.0.0
